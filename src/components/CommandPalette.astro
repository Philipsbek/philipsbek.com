---
import Icon from './Icon.astro';
import { nav, contact, socials, resumeUrl } from '../data/site.js';

const github = socials.find((s) => s.short === 'GitHub' && s.ready);

// Command groups. `action`: nav (same-origin), link (new tab), copy (clipboard).
const groups = [
  {
    name: 'Go to',
    items: nav.map((n) => ({ label: n.label, icon: 'arrow-right', action: 'nav', value: n.href })),
  },
  {
    name: 'Actions',
    items: [
      { label: 'Copy email address', icon: 'mail', action: 'copy', value: contact.email },
      {
        label: 'Chat on WhatsApp',
        icon: 'whatsapp',
        action: 'link',
        value: `${contact.whatsappUrl}?text=${encodeURIComponent(contact.whatsappMessage)}`,
      },
      { label: 'Download résumé', icon: 'download', action: 'nav', value: resumeUrl },
      ...(github
        ? [{ label: 'View GitHub profile', icon: 'github', action: 'link', value: github.url }]
        : []),
    ],
  },
];
---
<div class="cmdk" data-cmdk hidden>
  <div class="cmdk__backdrop" data-cmdk-close></div>
  <div class="cmdk__panel" role="dialog" aria-modal="true" aria-label="Command menu">
    <div class="cmdk__search">
      <Icon name="search" class="cmdk__search-icon" />
      <input
        type="text"
        class="cmdk__input"
        data-cmdk-input
        placeholder="Search pages and actions…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search commands"
      />
      <kbd class="cmdk__esc">Esc</kbd>
    </div>

    <div class="cmdk__list" data-cmdk-list role="listbox">
      {groups.map((group) => (
        <div class="cmdk__group" data-cmdk-group>
          <p class="cmdk__group-name">{group.name}</p>
          {group.items.map((item) => (
            <button
              class="cmdk__item"
              type="button"
              role="option"
              data-cmdk-item
              data-action={item.action}
              data-value={item.value}
              data-label={item.label}
            >
              <Icon name={item.icon} class="cmdk__item-icon" />
              <span class="cmdk__item-label">{item.label}</span>
              <span class="cmdk__item-hint" data-cmdk-hint></span>
            </button>
          ))}
        </div>
      ))}
      <p class="cmdk__empty" data-cmdk-empty hidden>No results.</p>
    </div>

    <div class="cmdk__foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> select</span>
      <span><kbd>Esc</kbd> close</span>
    </div>
  </div>
</div>

<style>
  .cmdk {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(1rem, 12vh, 8rem) 1rem 1rem;
  }
  .cmdk[hidden] {
    display: none;
  }
  .cmdk__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 5, 6, 0.6);
    backdrop-filter: blur(4px);
    animation: cmdk-fade 0.18s var(--ease);
  }
  .cmdk__panel {
    position: relative;
    width: 100%;
    max-width: 560px;
    background: var(--color-obsidian);
    border: 1px solid var(--color-graphite);
    border-radius: 14px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    animation: cmdk-pop 0.2s var(--ease);
  }
  @keyframes cmdk-fade {
    from { opacity: 0; }
  }
  @keyframes cmdk-pop {
    from { opacity: 0; transform: translateY(-8px) scale(0.99); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cmdk__backdrop,
    .cmdk__panel {
      animation: none;
    }
  }

  .cmdk__search {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--color-graphite);
  }
  .cmdk__search-icon {
    --icon-size: 18px;
    color: var(--color-fog);
    flex-shrink: 0;
  }
  .cmdk__input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-bone);
    font: inherit;
    font-size: 1rem;
  }
  .cmdk__input::placeholder {
    color: var(--color-ash);
  }
  .cmdk__esc {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fog);
    background: var(--glass-bg);
    border: 1px solid var(--color-graphite);
    border-radius: 5px;
    padding: 0.15rem 0.4rem;
  }

  .cmdk__list {
    max-height: min(52vh, 420px);
    overflow-y: auto;
    padding: 0.5rem;
  }
  .cmdk__group-name {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ash);
    padding: 0.6rem 0.6rem 0.35rem;
  }
  .cmdk__group[hidden] {
    display: none;
  }
  .cmdk__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.6rem 0.65rem;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--color-mist);
    font: inherit;
    font-size: 0.94rem;
    text-align: left;
  }
  .cmdk__item[hidden] {
    display: none;
  }
  .cmdk__item-icon {
    --icon-size: 17px;
    color: var(--color-fog);
    flex-shrink: 0;
  }
  .cmdk__item-label {
    flex: 1;
    min-width: 0;
  }
  .cmdk__item-hint {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-ice-blue);
    opacity: 0;
  }
  .cmdk__item.is-active {
    background: var(--glass-bg);
  }
  .cmdk__item.is-active .cmdk__item-icon {
    color: var(--color-mist);
  }
  .cmdk__item.is-active .cmdk__item-hint {
    opacity: 1;
  }
  .cmdk__empty {
    padding: 1.5rem;
    text-align: center;
    color: var(--color-fog);
    font-size: 0.92rem;
  }

  .cmdk__foot {
    display: flex;
    gap: 1.25rem;
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--color-graphite);
    color: var(--color-ash);
    font-size: 0.75rem;
  }
  .cmdk__foot kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fog);
    background: var(--glass-bg);
    border: 1px solid var(--color-graphite);
    border-radius: 4px;
    padding: 0.05rem 0.32rem;
    margin-right: 0.2rem;
  }
  @media (max-width: 520px) {
    .cmdk__foot {
      display: none;
    }
  }
</style>

<script>
  const root = document.querySelector('[data-cmdk]') as HTMLElement | null;
  if (root) {
    const input = root.querySelector('[data-cmdk-input]') as HTMLInputElement;
    const items = Array.from(root.querySelectorAll('[data-cmdk-item]')) as HTMLElement[];
    const groupsEls = Array.from(root.querySelectorAll('[data-cmdk-group]')) as HTMLElement[];
    const empty = root.querySelector('[data-cmdk-empty]') as HTMLElement;
    let active = 0;
    let lastFocused: HTMLElement | null = null;

    const visible = () => items.filter((it) => !it.hidden);

    const setActive = (idx: number) => {
      const vis = visible();
      if (!vis.length) return;
      active = (idx + vis.length) % vis.length;
      items.forEach((it) => it.classList.remove('is-active'));
      const hintEls = items.map((it) => it.querySelector('[data-cmdk-hint]') as HTMLElement);
      hintEls.forEach((h) => h && (h.textContent = ''));
      const el = vis[active];
      el.classList.add('is-active');
      const hint = el.querySelector('[data-cmdk-hint]') as HTMLElement;
      if (hint) hint.textContent = 'Enter';
      el.scrollIntoView({ block: 'nearest' });
    };

    const filter = () => {
      const q = input.value.trim().toLowerCase();
      items.forEach((it) => {
        const label = (it.dataset.label || '').toLowerCase();
        it.hidden = q.length > 0 && !label.includes(q);
      });
      groupsEls.forEach((g) => {
        const anyVisible = Array.from(g.querySelectorAll('[data-cmdk-item]')).some(
          (it) => !(it as HTMLElement).hidden
        );
        g.hidden = !anyVisible;
      });
      empty.hidden = visible().length > 0;
      setActive(0);
    };

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      root.hidden = false;
      document.body.style.overflow = 'hidden';
      input.value = '';
      filter();
      requestAnimationFrame(() => input.focus());
    };
    const close = () => {
      root.hidden = true;
      document.body.style.overflow = '';
      lastFocused?.focus?.();
    };

    const run = (el: HTMLElement) => {
      const action = el.dataset.action;
      const value = el.dataset.value || '';
      close();
      if (action === 'nav') {
        window.location.href = value;
      } else if (action === 'link') {
        window.open(value, '_blank', 'noopener,noreferrer');
      } else if (action === 'copy') {
        navigator.clipboard?.writeText(value).catch(() => {});
      }
    };

    // Triggers
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        root.hidden ? open() : close();
      } else if (e.key === 'Escape' && !root.hidden) {
        close();
      } else if (!root.hidden) {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          setActive(active + 1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          setActive(active - 1);
        } else if (e.key === 'Enter') {
          e.preventDefault();
          const vis = visible();
          if (vis[active]) run(vis[active]);
        }
      }
    });
    document.querySelectorAll('[data-command-trigger]').forEach((btn) =>
      btn.addEventListener('click', open)
    );
    root.querySelectorAll('[data-cmdk-close]').forEach((el) =>
      el.addEventListener('click', close)
    );
    input.addEventListener('input', filter);

    // Show the correct modifier per platform.
    const isMac = /Mac|iPhone|iPad/i.test(navigator.userAgent);
    document.querySelectorAll('[data-cmdk-kbd]').forEach((el) => {
      (el as HTMLElement).textContent = isMac ? '⌘K' : 'Ctrl K';
    });

    items.forEach((it) => {
      it.addEventListener('click', () => run(it));
      it.addEventListener('pointermove', () => {
        const vis = visible();
        const idx = vis.indexOf(it);
        if (idx >= 0 && idx !== active) setActive(idx);
      });
    });
  }
</script>
