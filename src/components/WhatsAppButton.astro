---
import { contact } from '../data/site.js';

// Build a wa.me link with a prefilled message from the central contact data.
const href = `${contact.whatsappUrl}?text=${encodeURIComponent(contact.whatsappMessage)}`;
---
<a
  class="wa-fab"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Philips on WhatsApp"
>
  <span class="wa-fab__label" aria-hidden="true">Chat on WhatsApp</span>
  <span class="wa-fab__btn">
    {/* Official WhatsApp glyph (kept monochrome via currentColor). */}
    <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.611-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
    </svg>
  </span>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 95;
    display: inline-block;
  }
  .wa-fab__btn {
    --icon-size: 26px;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--color-obsidian);
    border: 1px solid var(--color-graphite);
    color: var(--color-mist);
    box-shadow: var(--shadow-md);
    transition: transform 0.2s var(--ease), background 0.2s var(--ease),
      border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .wa-fab:hover .wa-fab__btn,
  .wa-fab:focus-visible .wa-fab__btn {
    transform: translateY(-2px);
    background: var(--color-graphite);
    border-color: var(--color-smoke);
    color: var(--color-paper);
  }

  /* Tooltip label that slides out on hover / focus. */
  .wa-fab__label {
    position: absolute;
    right: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    white-space: nowrap;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: var(--color-carbon);
    border: 1px solid var(--color-graphite);
    color: var(--color-mist);
    font-size: 0.82rem;
    box-shadow: var(--shadow-sm);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .wa-fab:hover .wa-fab__label,
  .wa-fab:focus-visible .wa-fab__label {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-fab__btn,
    .wa-fab__label {
      transition: none;
    }
  }

  /* Hide the tooltip on small screens (touch — no hover). */
  @media (max-width: 640px) {
    .wa-fab__label {
      display: none;
    }
  }
</style>
