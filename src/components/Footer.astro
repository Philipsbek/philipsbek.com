---
import { site, contact, nav, socials } from '../data/site.js';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const iconFor: Record<string, string> = {
  GitHub: 'github',
  LinkedIn: 'linkedin',
  WhatsApp: 'whatsapp',
  Email: 'mail',
};
---
<footer class="site-footer dark-panel">
  <div class="container container-wide">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="wordmark wordmark--footer" href="/" aria-label={`${site.name} — home`}>
          <span class="wordmark__mark">{site.initials}</span>
          <span>{site.name}</span>
        </a>
        <p>{site.tagline}</p>
        <a href="/contact" class="btn btn--light">
          Start a project <Icon name="arrow-right" />
        </a>
      </div>

      <div class="footer-cols">
        <nav class="footer-col" aria-label="Footer">
          <h2 class="footer-col__title">Explore</h2>
          <ul>
            {nav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>

        <div class="footer-col">
          <h2 class="footer-col__title">Get in touch</h2>
          <ul>
            <li>
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </li>
            <li>
              <a href={contact.whatsappUrl} target="_blank" rel="noopener noreferrer">
                {contact.phoneDisplay}
              </a>
            </li>
            <li class="footer-loc">{contact.location}</li>
          </ul>
        </div>

        <div class="footer-col">
          <h2 class="footer-col__title">Elsewhere</h2>
          <ul class="footer-socials">
            {socials.filter((s) => s.ready).map((s) => (
              <li>
                <a
                  href={s.url}
                  target={s.url.startsWith('http') ? '_blank' : undefined}
                  rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="footer-social"
                  title={s.handle}
                >
                  <Icon name={iconFor[s.short] || 'external'} />
                  <span>{s.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p class="footer-built">Designed &amp; built by {site.name}.</p>
    </div>
  </div>

  <button class="to-top" data-to-top aria-label="Back to top" hidden>
    <Icon name="arrow-up" />
  </button>
</footer>

<style>
  .site-footer {
    background: var(--color-void);
    border: none;
    border-top: 1px solid var(--line);
    padding-block: clamp(3.5rem, 6vw, 5.5rem) 2rem;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.1fr 2fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--navy-line);
  }
  .footer-brand p {
    color: var(--on-navy-muted);
    max-width: 24rem;
    margin: 1.1rem 0 1.75rem;
  }
  .wordmark--footer {
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 510;
    font-size: 1.05rem;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }
  .wordmark--footer .wordmark__mark {
    background: var(--color-obsidian);
    color: var(--color-paper);
    border: 1px solid var(--color-graphite);
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .footer-col__title {
    font-family: var(--font-text);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-navy-muted);
    margin-bottom: 1.1rem;
  }
  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .footer-col a {
    color: var(--on-navy);
    font-size: 0.95rem;
    transition: color 0.2s var(--ease);
  }
  .footer-col a:hover {
    color: var(--accent);
  }
  .footer-loc {
    color: var(--on-navy-muted);
    font-size: 0.95rem;
  }
  .footer-socials a {
    --icon-size: 17px;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 1.75rem;
    color: var(--on-navy-muted);
    font-size: 0.87rem;
  }

  @media (max-width: 780px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
    .footer-cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 460px) {
    .footer-cols {
      grid-template-columns: 1fr;
    }
  }

  /* Back to top */
  .to-top {
    --icon-size: 19px;
    position: fixed;
    /* Sits directly above the floating WhatsApp button (54px + gap). */
    right: calc(clamp(1rem, 3vw, 2rem) + 5px);
    bottom: calc(clamp(1rem, 3vw, 2rem) + 66px);
    z-index: 90;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: var(--color-obsidian);
    color: var(--color-mist);
    border: 1px solid var(--color-graphite);
    border-radius: 50%;
    box-shadow: var(--shadow-md);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease),
      background 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .to-top[data-visible] {
    opacity: 1;
    transform: none;
  }
  .to-top:hover {
    background: var(--color-acid-lime);
    color: var(--accent-ink);
    border-color: var(--color-acid-lime);
  }
</style>

<script>
  const btn = document.querySelector('[data-to-top]') as HTMLButtonElement | null;
  if (btn) {
    const toggle = () => {
      const show = window.scrollY > 600;
      btn.hidden = !show;
      if (show) btn.setAttribute('data-visible', '');
      else btn.removeAttribute('data-visible');
    };
    toggle();
    window.addEventListener('scroll', toggle, { passive: true });
    btn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
