---
import Icon from './Icon.astro';
import ThumbArt from './ThumbArt.astro';

const artForCategory: Record<string, string> = {
  'WordPress': 'site',
  'Business Website': 'site',
  'Web App UI': 'site',
  'E-Commerce': 'store',
  'AI & Automation': 'automation',
  'Landing Page': 'landing',
};

interface Project {
  slug: string;
  title: string;
  category: string;
  placeholder?: boolean;
  neon?: boolean;
  image?: string;
  overview: string;
  role: string;
  tools: string[];
  challenge: string;
  delivered: string;
  url: string;
  accent?: string;
}
interface Props {
  project: Project;
  delay?: number;
}
const { project, delay = 0 } = Astro.props;
const hasLink = project.url && project.url !== '#';
const artKind = artForCategory[project.category] ?? 'default';
---
<article
  class:list={['project-card', 'card', 'reveal', { 'project-card--neon': project.neon }]}
  data-category={project.category}
  style={`--reveal-delay: ${delay}ms`}
>
  <div class={`project-thumb project-thumb--${project.accent ?? 'a'}`} aria-hidden="true">
    {project.image ? (
      <img class="project-thumb__img" src={project.image} alt={`${project.title} website screenshot`} width="1200" height="750" loading="lazy" />
    ) : (
      <>
        <span class="project-thumb__pattern"></span>
        <ThumbArt kind={artKind} />
      </>
    )}
  </div>

  <div class="project-body">
    <div class="project-meta">
      <span class="tag">{project.category}</span>
      <span class="project-role">{project.role}</span>
    </div>
    <h3 class="h3 project-title">{project.title}</h3>
    <p class="project-overview">{project.overview}</p>

    <dl class="project-detail">
      <div>
        <dt>Objective</dt>
        <dd>{project.challenge}</dd>
      </div>
      <div>
        <dt>Delivered</dt>
        <dd>{project.delivered}</dd>
      </div>
    </dl>

    <ul class="project-tools">
      {project.tools.map((t) => <li class="tag">{t}</li>)}
    </ul>

    {hasLink && (
      <div class="project-foot">
        <a class="link-arrow" href={project.url} target="_blank" rel="noopener noreferrer">
          Visit site <Icon name="arrow-up-right" />
        </a>
      </div>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--line-strong);
  }

  /* Soft pastel gradient border shown only on hover (opt-in via `neon: true`).
     The card keeps the default hairline border at rest. */
  .project-card--neon::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    border-radius: inherit;
    padding: 1.5px; /* line thickness */
    background: conic-gradient(
      from 0deg,
      #ffc9de,
      #cfe3ff,
      #c9f5ff,
      #d3f3d0,
      #ffd0e6,
      #ffc9de
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .project-card--neon:hover::before {
    opacity: 1;
  }
  /* Soft pastel gradient on the category tag, with dark text for contrast. */
  .project-card--neon .project-meta .tag {
    background: linear-gradient(
      105deg,
      #ffc9de,
      #cfe3ff,
      #c9f5ff,
      #d3f3d0,
      #ffd0e6
    );
    border-color: rgba(0, 0, 0, 0.08);
    color: #16181d;
    font-weight: 500;
  }

  .project-thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .project-thumb--a { background: radial-gradient(120% 120% at 70% 0%, #17181c, #0d0e0f); }
  .project-thumb--b { background: radial-gradient(120% 120% at 70% 0%, #17181c, #0d0e0f); }
  .project-thumb--c { background: radial-gradient(120% 120% at 70% 0%, #17181c, #0d0e0f); }
  .project-thumb__pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.6;
  }
  .project-thumb__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.4s var(--ease);
  }
  .project-card:hover .project-thumb__img {
    transform: scale(1.03);
  }
  @media (prefers-reduced-motion: reduce) {
    .project-thumb__img {
      transition: none;
    }
  }
  .project-card:hover :global(.thumb-art) {
    transform: scale(1.03);
  }
  .project-body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    flex: 1;
  }
  .project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .project-role {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .project-title {
    margin-top: 0.1rem;
  }
  .project-overview {
    color: var(--muted);
    font-size: 0.96rem;
  }
  .project-detail {
    display: grid;
    gap: 0.75rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .project-detail dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fog);
    margin-bottom: 0.2rem;
  }
  .project-detail dd {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .project-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .project-tools .tag {
    font-size: 0.76rem;
    padding: 0.28rem 0.6rem;
  }
  .project-foot {
    margin-top: auto;
    padding-top: 0.4rem;
  }
</style>
