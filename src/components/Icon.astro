const d = paths[name] || '';
---
<svg
  class:list={['icon', className]}
  style={size ? `--icon-size:${size}` : undefined}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={d}
></svg>
