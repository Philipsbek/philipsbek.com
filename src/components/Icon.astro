  pin: '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>',
  check: '<polyline points="20 6 9 17 4 12"/>',
  browser: '<rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="7" y1="6.5" x2="7" y2="6.5"/><line x1="10" y1="6.5" x2="10" y2="6.5"/>',
  wordpress: '<circle cx="12" cy="12" r="9"/><path d="M4 9h9M8 4.5l4.5 12M15 5l-3 13M20 9c0 2-2 5-3.5 9"/>',
  cart: '<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>',
  gauge: '<path d="M12 21a9 9 0 1 0-9-9"/><path d="M3 12h2M12 3v2M19 5l-1.5 1.5M21 12h-2"/><line x1="12" y1="12" x2="16" y2="9"/>',
