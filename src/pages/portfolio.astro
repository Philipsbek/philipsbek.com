---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { projects, projectCategories } from '../data/site.js';

const showFilters = projects.length >= 4;
---
<BaseLayout
  title="Portfolio"
  path="/portfolio"
  description="Selected projects by Philips Bek — WordPress sites, WooCommerce stores, landing pages and AI-powered WhatsApp chatbots."
>
  <PageHeader
    eyebrow="Portfolio"
    title="Selected projects & builds."
    intro="A look at the websites, online stores and automations I build — from WordPress and WooCommerce to AI-powered WhatsApp chatbots."
  />

  <section class="section section--tight">
    <div class="container">
      <div class="legend reveal">
        <span class="legend__swatch" aria-hidden="true"></span>
        <p class="legend__text">
          <span class="legend__label">Style</span>
          Cards with a soft pastel accent are <strong>design concepts vibe-coded with Claude</strong>. The rest are live client builds.
        </p>
      </div>

      {showFilters && (
        <div class="filters reveal" role="tablist" aria-label="Filter projects by category">
          {projectCategories.map((cat, i) => (
            <button
              class:list={['filter-btn', { 'is-active': i === 0 }]}
              data-filter={cat}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              {cat}
            </button>
          ))}
        </div>
      )}

      <div class="grid grid-3" data-project-grid>
        {projects.map((p, i) => (
          <ProjectCard project={p} delay={i * 80} />
        ))}
      </div>

      <p class="no-results" data-no-results hidden>No projects in this category yet.</p>
    </div>
  </section>

  <ContactCTA heading="Want to be my next project?" text="If you like how I work, let’s talk about your website, store or automation." />
</BaseLayout>

<style>
  /* Legend / tip box explaining the pastel "Style" border. */
  .legend {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1.1rem;
    margin-bottom: 1.5rem;
    background: var(--color-carbon);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .legend__swatch {
    position: relative;
    flex-shrink: 0;
    width: 40px;
    height: 26px;
    border-radius: 6px;
    background: var(--color-void);
  }
  .legend__swatch::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.5px;
    background: conic-gradient(
      from 0deg,
      #ffc9de,
      #cfe3ff,
      #fdf3b0,
      #d3f3d0,
      #ffd0e6,
      #ffc9de
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }
  .legend__text {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.5;
  }
  .legend__label {
    display: inline-block;
    margin-right: 0.5rem;
    padding: 0.1rem 0.5rem;
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: #16181d;
    background: linear-gradient(105deg, #ffc9de, #cfe3ff, #fdf3b0, #d3f3d0, #ffd0e6);
    vertical-align: middle;
  }
  .legend__text strong {
    color: var(--color-mist);
    font-weight: 500;
  }
  @media (max-width: 480px) {
    .legend {
      align-items: flex-start;
    }
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .filter-btn {
    padding: 0.45rem 1rem;
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--color-mist);
    background: var(--chip-bg);
    border: 1px solid var(--line);
    border-radius: 999px;
    transition: all 0.2s var(--ease);
  }
  .filter-btn:hover {
    border-color: var(--color-smoke);
    color: var(--color-paper);
  }
  .filter-btn.is-active {
    background: var(--color-bone);
    color: var(--color-void);
    border-color: var(--color-bone);
  }

  .no-results {
    text-align: center;
    color: var(--muted);
    padding: 3rem 0;
  }

  /* Hidden by filter */
  :global(.project-card.is-hidden) {
    display: none;
  }
</style>

<script>
  function initFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    if (!buttons.length) return;
    const cards = document.querySelectorAll<HTMLElement>('[data-project-grid] .project-card');
    const noResults = document.querySelector<HTMLElement>('[data-no-results]');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-selected', String(active));
        });
        let visible = 0;
        cards.forEach((card) => {
          const match = filter === 'All' || card.dataset.category === filter;
          card.classList.toggle('is-hidden', !match);
          if (match) visible++;
        });
        if (noResults) noResults.hidden = visible !== 0;
      });
    });
  }
  initFilters();
</script>
