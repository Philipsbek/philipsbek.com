---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { nav } from '../data/site.js';

const suggestions = nav.filter((n) => n.href !== '/');
---
<BaseLayout title="Page not found" path="/404" description="The page you were looking for could not be found.">
  <section class="section notfound">
    <div class="container">
      <p class="notfound__code reveal">404</p>
      <h1 class="display notfound__title reveal" style="--reveal-delay: 60ms">This page took a wrong turn.</h1>
      <p class="lead notfound__text reveal" style="--reveal-delay: 120ms">
        The page you’re after doesn’t exist or may have moved. Let’s get you back on track.
      </p>
      <div class="notfound__actions reveal" style="--reveal-delay: 180ms">
        <a href="/" class="btn btn--primary"><Icon name="arrow-right" /> Back to home</a>
        <a href="/contact" class="btn btn--ghost">Contact me</a>
      </div>
      <div class="notfound__links reveal" style="--reveal-delay: 240ms">
        <span class="notfound__links-label">Or try:</span>
        {suggestions.map((s) => <a href={s.href} class="notfound__link">{s.label}</a>)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding-block: clamp(4rem, 12vw, 8rem);
  }
  .notfound__code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(4rem, 16vw, 9rem);
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.04em;
  }
  .notfound__title {
    margin-top: 0.5rem;
  }
  .notfound__text {
    margin: 1.25rem auto 0;
    max-width: 42ch;
  }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
    margin-top: 2rem;
  }
  .notfound__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    justify-content: center;
    align-items: center;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    max-width: 40rem;
    margin-inline: auto;
  }
  .notfound__links-label {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .notfound__link {
    font-weight: 500;
    color: var(--ink-soft);
    border-bottom: 1px solid transparent;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .notfound__link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
