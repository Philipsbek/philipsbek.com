---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { aiIntro, aiCapabilities, aiPrinciples } from '../data/site.js';

const tools = [
  { name: 'Make.com', use: 'Visual automation workflows' },
  { name: 'n8n', use: 'Flexible, self-hostable automation' },
  { name: 'Airtable', use: 'Structured data behind automations' },
  { name: 'AI chat & writing tools', use: 'Drafting, ideas and code assistance' },
  { name: 'WhatsApp', use: 'Chatbot delivery channel' },
  { name: 'AI video & content tools', use: 'Creative asset generation' },
];

const capIcons = ['pen', 'sparkles', 'workflow', 'robot'];
---
<BaseLayout
  title="AI & Automation"
  path="/ai-automation"
  description="How Philips Bek uses AI tools and automation platforms like Make.com and n8n to build faster and remove repetitive work — with human judgement in the loop."
>
  <PageHeader
    eyebrow="AI & Automation"
    title="Working smarter with AI, not just faster."
    intro="I’m an AI tools enthusiast, not an AI engineer — and that distinction matters. I use these tools to amplify real work, always with a human checking the result."
  />

  <!-- Philosophy -->
  <section class="section section--tight">
    <div class="container ai-intro">
      <div class="reveal">
        <p class="eyebrow">{aiIntro.eyebrow}</p>
        <h2 class="h2 ai-intro__title">{aiIntro.heading}</h2>
      </div>
      <p class="lead reveal" style="--reveal-delay: 80ms">{aiIntro.body}</p>
    </div>
  </section>

  <!-- Favourite AI coding tools -->
  <section class="section section--tight favourites-section">
    <div class="container">
      <div class="favourites-head reveal">
        <p class="eyebrow">My main favourites</p>
        <h2 class="h2">The two I build with most.</h2>
        <p class="muted">Claude Code and Codex are my primary AI coding partners for turning ideas into polished, working web experiences.</p>
      </div>

      <div class="favourites-grid">
        <article class="favourite-tool favourite-tool--claude reveal">
          <div class="favourite-tool__mark" aria-hidden="true">
            <img src="/brands/claude.svg" alt="" width="184" height="184" loading="lazy" />
          </div>
          <div class="favourite-tool__copy">
            <span class="favourite-tool__index">01</span>
            <h3>Claude Code</h3>
            <p>My go-to for thoughtful implementation, interface exploration and working through complex builds with strong context.</p>
          </div>
        </article>

        <article class="favourite-tool favourite-tool--codex reveal" style="--reveal-delay: 80ms">
          <div class="favourite-tool__mark" aria-hidden="true">
            <img src="/brands/codex.png" alt="" width="256" height="256" loading="lazy" />
          </div>
          <div class="favourite-tool__copy">
            <span class="favourite-tool__index">02</span>
            <h3>Codex</h3>
            <p>My choice for precise codebase work, rapid iteration, testing and carrying complete features through to a verified result.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section ai-band">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Where I use it</p>
        <h2 class="h2">AI &amp; automation in practice</h2>
        <p>Concrete, day-to-day ways I fold these tools into building websites and running workflows.</p>
      </div>
      <div class="grid grid-2">
        {aiCapabilities.map((c, i) => (
          <article class="ai-card card reveal" style={`--reveal-delay:${i * 70}ms`}>
            <span class="ai-card__icon"><Icon name={capIcons[i % capIcons.length]} /></span>
            <div>
              <h3 class="h3">{c.title}</h3>
              <p class="muted">{c.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Tools -->
  <section class="section">
    <div class="container">
      <div class="ai-tools">
        <div class="ai-tools__head reveal">
          <p class="eyebrow">Toolbox</p>
          <h2 class="h2">Tools I reach for</h2>
          <p class="muted">A practical mix of automation platforms, data tools and AI assistants — chosen to fit the job, not the hype.</p>
        </div>
        <ul class="ai-tools__list">
          {tools.map((t, i) => (
            <li class="ai-tool reveal" style={`--reveal-delay:${i * 50}ms`}>
              <span class="ai-tool__name">{t.name}</span>
              <span class="ai-tool__use">{t.use}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="section section--tight">
    <div class="container">
      <div class="principles dark-panel reveal">
        <svg class="principles__net" viewBox="0 0 240 200" fill="none" aria-hidden="true">
          <g stroke="#fff" stroke-width="1.4" opacity="0.5">
            <line x1="40" y1="50" x2="150" y2="36" />
            <line x1="40" y1="50" x2="96" y2="120" />
            <line x1="150" y1="36" x2="210" y2="96" />
            <line x1="96" y1="120" x2="210" y2="96" />
            <line x1="96" y1="120" x2="60" y2="168" />
            <line x1="210" y1="96" x2="188" y2="164" />
          </g>
          <g fill="var(--color-iris-violet)" stroke="var(--color-mist)" stroke-width="1.4">
            <circle cx="40" cy="50" r="9" />
            <circle cx="150" cy="36" r="9" />
            <circle cx="96" cy="120" r="9" />
            <circle cx="210" cy="96" r="9" />
            <circle cx="60" cy="168" r="6.5" />
            <circle cx="188" cy="164" r="6.5" />
          </g>
        </svg>
        <div class="principles__head">
          <p class="eyebrow">My approach</p>
          <h2 class="h2">Human judgement stays in the loop</h2>
          <p>A few rules I hold myself to when working with AI:</p>
        </div>
        <ul class="principles__list">
          {aiPrinciples.map((p, i) => (
            <li>
              <span class="principles__num">{String(i + 1).padStart(2, '0')}</span>
              <span>{p}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <ContactCTA heading="Have a workflow worth automating?" text="If you’re drowning in repetitive tasks or want an AI chatbot exploring, let’s map it out together." />
</BaseLayout>

<style>
  .ai-intro {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  .ai-intro__title {
    margin-top: 0.75rem;
    max-width: 14ch;
  }

  .favourites-section {
    padding-top: 0;
  }
  .favourites-head {
    display: grid;
    grid-template-columns: 0.75fr 1fr 1.1fr;
    gap: clamp(1rem, 4vw, 3rem);
    align-items: end;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: clamp(2rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
  }
  .favourites-head .h2 {
    max-width: 12ch;
  }
  .favourites-head > p:last-child {
    max-width: 48ch;
  }
  .favourites-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .favourite-tool {
    position: relative;
    isolation: isolate;
    min-height: 390px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: transform 0.35s var(--ease), border-color 0.35s var(--ease), background 0.35s var(--ease);
  }
  .favourite-tool::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background: radial-gradient(circle at 70% 20%, var(--tool-glow), transparent 52%);
    transition: opacity 0.35s var(--ease);
  }
  .favourite-tool:hover {
    transform: translateY(-5px);
    border-color: var(--line-strong);
  }
  .favourite-tool:hover::before {
    opacity: 1;
  }
  .favourite-tool--claude {
    --tool-color: #d6a982;
    --tool-glow: rgb(214 169 130 / 0.13);
  }
  .favourite-tool--codex {
    --tool-color: var(--color-paper);
    --tool-glow: rgb(92 235 255 / 0.1);
  }
  .favourite-tool__mark {
    width: clamp(8rem, 18vw, 11.5rem);
    color: var(--tool-color);
    transform-origin: top left;
    transition: transform 0.45s var(--ease), filter 0.45s var(--ease);
  }
  .favourite-tool:hover .favourite-tool__mark {
    transform: rotate(-3deg) scale(1.04);
    filter: drop-shadow(0 0 22px var(--tool-glow));
  }
  .favourite-tool__mark svg,
  .favourite-tool__mark img {
    display: block;
    width: 100%;
    height: auto;
  }
  :global(:root[data-theme='light']) .favourite-tool--codex .favourite-tool__mark img {
    filter: invert(1);
  }
  .favourite-tool__copy {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem 1rem;
    align-items: baseline;
  }
  .favourite-tool__index {
    grid-row: 1 / span 2;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }
  .favourite-tool h3 {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 560;
    letter-spacing: -0.035em;
  }
  .favourite-tool p {
    max-width: 46ch;
    color: var(--muted);
    font-size: 0.93rem;
  }

  .ai-band {
    background: var(--paper-2);
    border-block: 1px solid var(--line);
  }
  .ai-card {
    display: flex;
    gap: 1.1rem;
    padding: clamp(1.5rem, 2.5vw, 1.9rem);
    align-items: flex-start;
  }
  .ai-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .ai-card__icon {
    --icon-size: 21px;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    background: var(--chip-bg);
    color: var(--color-mist);
    border: 1px solid var(--line);
  }
  .ai-card h3 {
    margin-bottom: 0.4rem;
  }

  .ai-tools {
    display: grid;
    grid-template-columns: 0.9fr 1.4fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .ai-tools__head .h2 {
    margin: 0.75rem 0 1rem;
  }
  .ai-tools__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }
  .ai-tool {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1.1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .ai-tool:hover {
    border-color: var(--color-smoke);
    transform: translateY(-2px);
  }
  .ai-tool__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
  }
  .ai-tool__use {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .principles {
    position: relative;
    overflow: hidden;
    border-radius: clamp(18px, 3vw, 28px);
    padding: clamp(2.25rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .principles__net {
    position: absolute;
    right: clamp(-30px, -1vw, 0px);
    bottom: -20px;
    width: clamp(150px, 22vw, 250px);
    height: auto;
    opacity: 0.5;
    pointer-events: none;
    z-index: 0;
  }
  .principles__head,
  .principles__list {
    position: relative;
    z-index: 1;
  }
  .principles__head p {
    color: var(--on-navy-muted);
  }
  @media (max-width: 620px) {
    .principles__net {
      opacity: 0.28;
    }
  }
  .principles__head .h2 {
    margin: 0.75rem 0 1rem;
  }
  .principles__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .principles__list li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--navy-line);
    color: var(--on-navy);
  }
  .principles__list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .principles__num {
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--color-fog);
    flex-shrink: 0;
  }

  @media (max-width: 820px) {
    .ai-intro,
    .ai-tools,
    .principles {
      grid-template-columns: 1fr;
    }
    .favourites-head {
      grid-template-columns: 1fr 1fr;
    }
    .favourites-head > p:last-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .favourites-head,
    .favourites-grid {
      grid-template-columns: 1fr;
    }
    .favourite-tool {
      min-height: 330px;
    }
    .ai-tools__list {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .favourite-tool,
    .favourite-tool::before,
    .favourite-tool__mark {
      transition: none;
    }
  }
</style>
