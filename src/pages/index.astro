---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import {
  site,
  featuredSkills,
  projects,
  services,
  experience,
} from '../data/site.js';

const featuredProjects = projects.slice(0, 3);
const homeServices = services.slice(0, 4);
---
<BaseLayout path="/">
  <!-- HERO -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="hero__decor" aria-hidden="true">
      <svg viewBox="0 0 460 460" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="pbAccent" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#87f6f5" />
            <stop offset="0.5" stop-color="#ffe5f1" />
            <stop offset="1" stop-color="#f042ff" />
          </linearGradient>
        </defs>
        <circle cx="330" cy="150" r="150" stroke="url(#pbAccent)" stroke-width="1.4" opacity="0.16" />
        <circle cx="330" cy="150" r="112" stroke="url(#pbAccent)" stroke-width="1.4" opacity="0.12" />
        <circle cx="330" cy="150" r="74" stroke="url(#pbAccent)" stroke-width="1.4" opacity="0.09" />
        <g fill="var(--ink)" opacity="0.06">
          {Array.from({ length: 6 }).map((_, r) =>
            Array.from({ length: 6 }).map((_, c) => (
              <circle cx={40 + c * 26} cy={40 + r * 26} r="2" />
            ))
          )}
        </g>
      </svg>
    </div>
    <div class="container hero__inner">
      <div class="hero__content">
        <p class="eyebrow reveal">
          {site.role}
        </p>
        <h1 class="hero__title reveal" style="--reveal-delay: 80ms">
          I build modern websites and <span class="hero__rotate"><span class="hero__rotate-inner" data-rotate>smarter</span></span> digital experiences.
        </h1>
        <p class="hero__intro lead reveal" style="--reveal-delay: 160ms">
          I’m {site.name.split(' ')[0]}, a web and WordPress developer in {site.location}. I take
          projects from first build to launch — design, hosting, domains and SEO — and use AI tools
          and automation to work faster and smarter.
        </p>
        <div class="hero__actions">
          <a href="/portfolio" class="btn btn--primary">
            View my work <Icon name="arrow-right" />
          </a>
          <a href="/contact" class="btn btn--ghost">
            Contact me
          </a>
        </div>
        <div class="hero__meta reveal" style="--reveal-delay: 320ms">
          <span class="hero__status">Available for work</span>
          <span class="hero__loc"><Icon name="pin" /> {site.location}</span>
        </div>
      </div>

      <div class="hero__aside reveal" style="--reveal-delay: 200ms" aria-hidden="true">
        <div class="hero-panel" data-tilt>
          <div class="hero-panel__head">
            <span class="hero-panel__eyebrow">
              <span class="hero-panel__dot"></span> Capabilities
            </span>
            <span class="hero-panel__meta">01 — 03</span>
          </div>
          <ul class="hero-panel__list">
            <li class="cap-row">
              <span class="cap-row__idx">01</span>
              <span class="cap-row__body">
                <span class="cap-row__title">Web Design</span>
                <span class="cap-row__desc">Responsive layouts · Clear user journeys · Polished interfaces</span>
              </span>
              <Icon name="arrow-up-right" class="cap-row__arrow" />
            </li>
            <li class="cap-row">
              <span class="cap-row__idx">02</span>
              <span class="cap-row__body">
                <span class="cap-row__title">WordPress Development</span>
                <span class="cap-row__desc">Elementor builds · WooCommerce · SEO foundations</span>
              </span>
              <Icon name="arrow-up-right" class="cap-row__arrow" />
            </li>
            <li class="cap-row">
              <span class="cap-row__idx">03</span>
              <span class="cap-row__body">
                <span class="cap-row__title">AI Workflows</span>
                <span class="cap-row__desc">Make.com &amp; n8n · AI-assisted delivery · Smarter processes</span>
              </span>
              <Icon name="arrow-up-right" class="cap-row__arrow" />
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SKILLS MARQUEE / STRIP -->
  <section class="skills-strip">
    <div class="container">
      <div class="skills-strip__inner reveal">
        <span class="skills-strip__label">Core toolkit</span>
        <div class="marquee" data-marquee>
          <ul class="marquee__track">
            {featuredSkills.map((s) => <li>{s}</li>)}
            {featuredSkills.map((s) => <li aria-hidden="true">{s}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURED WORK -->
  <section class="section featured-work">
    <div class="container">
      <div class="section-head-row">
        <div class="section-head reveal" style="margin-bottom:0">
          <p class="eyebrow">Selected work</p>
          <h2 class="h2">Featured projects</h2>
          <p>A snapshot of the kind of websites and automations I build, from WordPress sites to AI-driven workflows.</p>
        </div>
        <a href="/portfolio" class="link-arrow reveal">
          All projects <Icon name="arrow-right" />
        </a>
      </div>

      <div class="grid grid-3">
        {featuredProjects.map((p, i) => (
          <ProjectCard project={p} delay={i * 90} />
        ))}
      </div>
    </div>
  </section>

  <!-- CURRENTLY BUILDING -->
  <section class="section building-band">
    <div class="container">
      <div class="building">
        <div class="building__text reveal">
          <p class="eyebrow building__eyebrow">
            <span class="building__pulse" aria-hidden="true"></span> Currently building
          </p>
          <h2 class="h2 building__title">Stackceipt</h2>
          <p class="building__tagline">Software subscription governance for SMBs.</p>
          <p class="building__desc">
            One calm, financially precise place to track every subscription, renewal, approval and
            review — and cut the cost of tools a team no longer needs. I’m designing and building it
            end to end.
          </p>
          <ul class="building__points">
            <li>Live spend, renewals &amp; savings dashboard</li>
            <li>“Janitor” findings that flag unused seats &amp; waste</li>
            <li>Requests, reviews &amp; offboarding workflows</li>
          </ul>
          <ul class="building__tags" aria-label="Project focus">
            <li class="tag">SaaS product</li>
            <li class="tag">Product design</li>
            <li class="tag">Dashboard UI</li>
            <li class="tag">Finance &amp; ops</li>
          </ul>
          <div class="building__actions">
            <a
              class="btn btn--primary"
              href="https://stackceipt-beta.vercel.app"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit live site <Icon name="arrow-up-right" />
            </a>
            <span class="building__status">In active development</span>
          </div>
        </div>

        <div class="building__visual reveal" style="--reveal-delay: 120ms">
          <img
            class="building__shot"
            src="/projects/stackceipt-cards.png"
            alt="Stackceipt interface cards: monthly recurring spend, subscription list, automated savings findings and an upcoming renewal notice"
            width="1300"
            height="1257"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES OVERVIEW -->
  <section class="section section--tight services-band">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">What I do</p>
        <h2 class="h2">Services, end to end</h2>
        <p>From a single landing page to a full store with automation behind it — here’s where I can help.</p>
      </div>

      <div class="services-list">
        {homeServices.map((s, i) => (
          <a href="/services" class="service-row reveal" style={`--reveal-delay:${i * 70}ms`}>
            <span class="service-row__icon"><Icon name={s.icon} /></span>
            <span class="service-row__text">
              <span class="service-row__title">{s.title}</span>
              <span class="service-row__blurb">{s.blurb}</span>
            </span>
            <Icon name="arrow-up-right" class="service-row__arrow" />
          </a>
        ))}
      </div>
      <div class="services-band__cta reveal">
        <a href="/services" class="link-arrow">Explore all services <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <!-- EXPERIENCE SUMMARY -->
  <section class="section">
    <div class="container">
      <div class="exp-grid">
        <div class="exp-intro reveal">
          <p class="eyebrow">Experience</p>
          <h2 class="h2">A few years of building for the web</h2>
          <p class="muted">
            From testing sites as an intern to shipping complete builds and AI chatbots, I’ve worked
            across the full lifecycle of a modern website.
          </p>
          <a href="/about" class="btn btn--ghost">
            More about me <Icon name="arrow-right" />
          </a>
        </div>
        <ol class="exp-timeline">
          {experience.map((job, i) => (
            <li class="exp-item reveal" style={`--reveal-delay:${i * 80}ms`}>
              <span class="exp-item__period">{job.period}</span>
              <div class="exp-item__body">
                <h3 class="exp-item__role">{job.role}</h3>
                <span class="exp-item__company">{job.company}</span>
                <p>{job.summary}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;

  // Cleanup handle for the previous home instance (view transitions re-run this).
  let teardown: (() => void) | null = null;

  function initHome() {
    teardown?.();
    teardown = null;

    const hero = document.querySelector('.hero') as HTMLElement | null;
    if (!hero) return; // not the home page

    const cleanups: Array<() => void> = [];

    // ---- Pointer parallax on the hero backdrop ----------------------------
    const decor = hero.querySelector('.hero__decor') as HTMLElement | null;
    if (decor && !reduce && fine) {
      const move = (e: PointerEvent) => {
        const r = hero.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        decor.style.transform = `translate(${x * -22}px, ${y * -14}px)`;
      };
      const leave = () => (decor.style.transform = '');
      hero.addEventListener('pointermove', move);
      hero.addEventListener('pointerleave', leave);
      cleanups.push(() => {
        hero.removeEventListener('pointermove', move);
        hero.removeEventListener('pointerleave', leave);
      });
    }

    // ---- Rotating headline word -------------------------------------------
    const rot = document.querySelector('[data-rotate]') as HTMLElement | null;
    if (rot && !reduce) {
      const words = ['smarter', 'sharper', 'faster', 'bolder'];
      let i = 0;
      const id = setInterval(() => {
        rot.style.opacity = '0';
        rot.style.transform = 'translateY(-0.3em)';
        setTimeout(() => {
          i = (i + 1) % words.length;
          rot.textContent = words[i];
          rot.style.transform = 'translateY(0.3em)';
          requestAnimationFrame(() => {
            rot.style.opacity = '1';
            rot.style.transform = 'translateY(0)';
          });
        }, 300);
      }, 2800);
      cleanups.push(() => clearInterval(id));
    }

    // ---- Hero card: 3D tilt + pointer sheen -------------------------------
    const card = document.querySelector('[data-tilt]') as HTMLElement | null;
    if (card && !reduce && fine) {
      const MAX = 7;
      const move = (e: PointerEvent) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        card.style.transform = `rotateX(${(0.5 - py) * MAX}deg) rotateY(${(px - 0.5) * MAX}deg)`;
        card.style.setProperty('--sx', `${px * 100}%`);
        card.style.setProperty('--sy', `${py * 100}%`);
      };
      const leave = () => (card.style.transform = '');
      card.addEventListener('pointermove', move);
      card.addEventListener('pointerleave', leave);
      cleanups.push(() => {
        card.removeEventListener('pointermove', move);
        card.removeEventListener('pointerleave', leave);
      });
    }

    // ---- Hero card: animated particle-network background ------------------
    const canvas = document.querySelector('[data-hero-fx]') as HTMLCanvasElement | null;
    if (canvas) {
      const host = canvas.parentElement as HTMLElement;
      const ctx = canvas.getContext('2d');
      const ACCENT = [240, 66, 255];
      let w = 0, h = 0, dpr = 1, raf = 0;
      let particles: { x: number; y: number; vx: number; vy: number }[] = [];
      const pointer = { x: -999, y: -999 };
      // Particle colour follows the theme (dark on light, white on dark).
      const inkOf = () =>
        getComputedStyle(document.documentElement).getPropertyValue('--fx-ink').trim() ||
        '255, 255, 255';
      let fxInk = inkOf();
      const onTheme = () => (fxInk = inkOf());
      document.addEventListener('themechange', onTheme);
      cleanups.push(() => document.removeEventListener('themechange', onTheme));

      const resize = () => {
        const r = host.getBoundingClientRect();
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = r.width;
        h = r.height;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        canvas.style.width = w + 'px';
        canvas.style.height = h + 'px';
        if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const count = Math.max(26, Math.min(46, Math.round((w * h) / 5200)));
        particles = Array.from({ length: count }, () => ({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.22,
          vy: (Math.random() - 0.5) * 0.22,
        }));
      };

      const draw = () => {
        if (!ctx) return;
        ctx.clearRect(0, 0, w, h);
        const t = Date.now() / 4200;
        const gx = w * (0.5 + Math.cos(t) * 0.3);
        const gy = h * (0.35 + Math.sin(t * 0.8) * 0.25);
        const glow = ctx.createRadialGradient(gx, gy, 0, gx, gy, Math.max(w, h) * 0.7);
        glow.addColorStop(0, 'rgba(240,66,255,0.05)');
        glow.addColorStop(1, 'rgba(240,66,255,0)');
        ctx.fillStyle = glow;
        ctx.fillRect(0, 0, w, h);
        for (const p of particles) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0 || p.x > w) p.vx *= -1;
          if (p.y < 0 || p.y > h) p.vy *= -1;
        }
        for (let i = 0; i < particles.length; i++) {
          const a = particles[i];
          for (let j = i + 1; j < particles.length; j++) {
            const b = particles[j];
            const dx = a.x - b.x, dy = a.y - b.y;
            const d2 = dx * dx + dy * dy;
            if (d2 < 92 * 92) {
              const o = (1 - Math.sqrt(d2) / 92) * 0.22;
              ctx.strokeStyle = `rgba(${fxInk},${o})`;
              ctx.lineWidth = 1;
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.stroke();
            }
          }
          const pdx = a.x - pointer.x, pdy = a.y - pointer.y;
          const pd2 = pdx * pdx + pdy * pdy;
          if (pd2 < 120 * 120) {
            const o = (1 - Math.sqrt(pd2) / 120) * 0.5;
            ctx.strokeStyle = `rgba(${ACCENT[0]},${ACCENT[1]},${ACCENT[2]},${o})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(pointer.x, pointer.y);
            ctx.stroke();
          }
        }
        for (const p of particles) {
          ctx.fillStyle = `rgba(${fxInk},0.55)`;
          ctx.beginPath();
          ctx.arc(p.x, p.y, 1.4, 0, Math.PI * 2);
          ctx.fill();
        }
        raf = requestAnimationFrame(draw);
      };

      resize();
      if (reduce) {
        draw();
        cancelAnimationFrame(raf);
      } else {
        raf = requestAnimationFrame(draw);
      }

      const ro = new ResizeObserver(() => resize());
      ro.observe(host);

      let io: IntersectionObserver | null = null;
      if ('IntersectionObserver' in window && !reduce) {
        io = new IntersectionObserver((entries) => {
          for (const en of entries) {
            if (en.isIntersecting) {
              if (!raf) raf = requestAnimationFrame(draw);
            } else {
              cancelAnimationFrame(raf);
              raf = 0;
            }
          }
        });
        io.observe(canvas);
      }

      if (card && fine) {
        const pm = (e: PointerEvent) => {
          const r = canvas.getBoundingClientRect();
          pointer.x = e.clientX - r.left;
          pointer.y = e.clientY - r.top;
        };
        const pl = () => (pointer.x = pointer.y = -999);
        card.addEventListener('pointermove', pm);
        card.addEventListener('pointerleave', pl);
        cleanups.push(() => {
          card.removeEventListener('pointermove', pm);
          card.removeEventListener('pointerleave', pl);
        });
      }

      cleanups.push(() => {
        cancelAnimationFrame(raf);
        ro.disconnect();
        io?.disconnect();
      });
    }

    teardown = () => cleanups.forEach((fn) => fn());
  }

  initHome();
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    background-color: var(--color-void);
    /* Keep the hero a dark cinematic zone in both themes, so text stays light
       over the wallpaper. Re-point the raw palette to its dark values; the
       semantic tokens (--ink, --muted, --line …) resolve through them. The
       explicit color makes the headline inherit light (it would otherwise
       inherit body's already-resolved dark colour in light theme). */
    color: var(--ink);
    /* Raw palette (for elements that reference --color-* directly, e.g. the
       rotating word and ghost button). */
    --color-graphite: #23252a;
    --color-smoke: #383b3f;
    --color-ash: #62666d;
    --color-fog: #8a8f98;
    --color-mist: #d0d6e0;
    --color-bone: #e5e5e6;
    --color-paper: #ffffff;
    /* Semantic tokens must be set directly: they're declared on :root, so they
       compute there and inherit resolved — overriding the raw tokens alone
       wouldn't change them. */
    --ink: #ffffff;
    --ink-soft: #d0d6e0;
    --muted: #8a8f98;
    --line: #23252a;
    --line-strong: #383b3f;
  }
  /* Full-bleed lofi cyberpunk wallpaper + readability scrim. */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        rgba(5, 6, 13, 0.92) 0%,
        rgba(5, 6, 13, 0.74) 30%,
        rgba(5, 6, 13, 0.4) 60%,
        rgba(5, 6, 13, 0.16) 100%
      ),
      linear-gradient(
        180deg,
        rgba(5, 6, 13, 0.55) 0%,
        rgba(5, 6, 13, 0) 28%,
        rgba(5, 6, 13, 0.22) 72%,
        rgba(5, 6, 13, 0.82) 100%
      ),
      url('/images/hero-bg.jpg') center / cover no-repeat;
  }
  .hero__decor {
    position: absolute;
    top: -70px;
    right: -60px;
    width: min(46vw, 460px);
    pointer-events: none;
    z-index: 0;
    transition: transform 0.4s var(--ease);
    will-change: transform;
  }
  .hero__decor svg {
    width: 100%;
    height: auto;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(500px, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  @media (max-width: 880px) {
    .hero__decor {
      display: none;
    }
  }
  .hero__title {
    font-size: clamp(2.6rem, 6.2vw, 4.6rem);
    line-height: 1.03;
    margin-top: 1.25rem;
    letter-spacing: -0.03em;
  }
  /* Rotating headline word */
  .hero__rotate {
    position: relative;
    display: inline-block;
  }
  .hero__rotate-inner {
    display: inline-block;
    color: var(--color-paper);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .hero__rotate::after {
    content: '';
    position: absolute;
    left: 0.02em;
    right: 0.02em;
    bottom: 0.02em;
    height: 3px;
    border-radius: 3px;
    background: var(--accent-gradient);
    opacity: 0.85;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__rotate-inner {
      transition: none;
    }
  }
  .hero__intro {
    margin-top: 1.5rem;
    max-width: 46ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .hero__status::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-pulse-green);
    box-shadow: 0 0 0 4px rgba(39, 166, 68, 0.18);
  }
  .hero__loc {
    --icon-size: 15px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Hero aside card */
  .hero__aside {
    display: flex;
    justify-content: center;
    perspective: 1000px;
  }
  /* Linear-style capabilities panel — dark glass precision instrument */
  .hero-panel {
    position: relative;
    width: 100%;
    max-width: 460px;
    padding: 20px;
    border-radius: 12px;
    background: rgba(14, 15, 18, 0.58);
    -webkit-backdrop-filter: blur(16px) saturate(130%);
    backdrop-filter: blur(16px) saturate(130%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow: var(--shadow-lg), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transform-style: preserve-3d;
    transition: transform 0.35s var(--ease);
    will-change: transform;
  }
  /* pointer sheen driven by --sx/--sy from the tilt script */
  .hero-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      200px 200px at var(--sx, 50%) var(--sy, 0%),
      rgba(255, 255, 255, 0.07),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.3s var(--ease);
    pointer-events: none;
  }
  .hero-panel:hover::after {
    opacity: 1;
  }
  .hero-panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .hero-panel__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
