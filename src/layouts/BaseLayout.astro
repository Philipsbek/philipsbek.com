---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { site, contact, socials } from '../data/site.js';

interface Props {
  title?: string;
  description?: string;
  /** Path for canonical/OG url, e.g. "/about". Defaults to current path. */
  path?: string;
  ogType?: string;
}

const {
  title,
  description = site.description,
  path,
  ogType = 'website',
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonicalPath = path ?? Astro.url.pathname;
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin).href;
const ogImage = new URL('/og-image.svg', Astro.site ?? Astro.url.origin).href;

// Structured data: Person + WebSite.
const readySocials = socials.filter((s) => s.ready && s.url.startsWith('http')).map((s) => s.url);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: `mailto:${contact.email}`,
  url: (Astro.site ?? Astro.url.origin).toString(),
  ...(site.photo ? { image: new URL(site.photo, Astro.site ?? Astro.url.origin).href } : {}),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kuala Lumpur',
    addressCountry: 'MY',
  },
  knowsAbout: ['Web Development', 'WordPress', 'WooCommerce', 'SEO', 'Workflow Automation', 'AI Tools'],
  ...(readySocials.length ? { sameAs: readySocials } : {}),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#08090a" />

    <!-- Apply the saved theme before paint so it never flashes. Dark is the default. -->
    <script is:inline>
      (() => {
        let t = null;
        try {
          t = localStorage.getItem('theme');
        } catch (e) {}
        if (t === 'light') document.documentElement.dataset.theme = 'light';
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', t === 'light' ? '#ffffff' : '#08090a');
      })();
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_MY" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon & PWA -->
    <link rel="icon" href="/favicon.svg?v=7" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico?v=7" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=7" />
    <link rel="manifest" href="/manifest.webmanifest?v=7" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300..600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <slot name="head" />
  </head>
  <body>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <CommandPalette />

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const fine = window.matchMedia('(pointer: fine)').matches;
      // Native scroll-driven animation support — when present, CSS handles the
      // reveals and scroll-progress and we skip the JS fallbacks entirely.
      const sdaView = CSS.supports('animation-timeline: view()');
      const sdaScroll = CSS.supports('animation-timeline: scroll()');

      // ---- Page effects ------------------------------------------------------
      function initPageEffects() {
        // Reveal-on-scroll (JS fallback only; CSS scroll-timeline handles it otherwise)
        if (!sdaView) {
          const els = document.querySelectorAll('.reveal:not(.is-visible)');
          if (reduce || !('IntersectionObserver' in window)) {
            els.forEach((el) => el.classList.add('is-visible'));
          } else {
            const io = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  obs.unobserve(entry.target);
                }
              });
            },
              { rootMargin: '0px 0px -8% 0px', threshold: 0.1 }
            );
            els.forEach((el) => io.observe(el));
          }
        }

        // Pointer spotlight on cards
        document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
          if (card.dataset.spot) return;
          card.dataset.spot = '1';
          card.addEventListener('pointermove', (e: PointerEvent) => {
            const r = card.getBoundingClientRect();
            card.style.setProperty('--mx', e.clientX - r.left + 'px');
            card.style.setProperty('--my', e.clientY - r.top + 'px');
          });
        });

        // Magnetic primary/light buttons
        if (!reduce && fine) {
          document.querySelectorAll<HTMLElement>('.btn--primary, .btn--light').forEach((btn) => {
            if (btn.dataset.mag) return;
            btn.dataset.mag = '1';
            btn.addEventListener('pointermove', (e: PointerEvent) => {
              const r = btn.getBoundingClientRect();
              const mx = e.clientX - (r.left + r.width / 2);
              const my = e.clientY - (r.top + r.height / 2);
              btn.style.transform = `translate(${mx * 0.15}px, ${my * 0.3}px)`;
            });
            btn.addEventListener('pointerleave', () => {
              btn.style.transform = '';
            });
          });
        }
      }
      initPageEffects();

      // ---- Scroll-progress bar (JS fallback; CSS scroll-timeline handles it
      //      natively when supported) -----------------------------------------
      if (!sdaScroll) {
        const update = () => {
          const prog = document.querySelector<HTMLElement>('[data-scroll-progress]');
          if (!prog) return;
          const scroller = document.scrollingElement || document.documentElement;
          const max = scroller.scrollHeight - window.innerHeight;
          const y = window.scrollY || scroller.scrollTop;
          const p = max > 0 ? y / max : 0;
          prog.style.setProperty('--p', Math.min(1, Math.max(0, p)).toFixed(4));
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update, { passive: true });
        update();
      }
    </script>
  </body>
</html>
